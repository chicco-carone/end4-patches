     implicitWidth: isMaterial && !root.vertical ? flow.implicitWidth : root.vertical ? Appearance.sizes.verticalBarWidth - 14 : flow.implicitWidth + 4
     implicitHeight: isMaterial && root.vertical ? flow.implicitHeight: isMaterial ? 32 : root.vertical ? flow.implicitHeight + 4 : Appearance.sizes.barHeight
 
+    function cycleDisplayMode() {
+        switch (Config.options.bar.utilButtons.displayMode) {
+        case "auto": Config.options.bar.utilButtons.displayMode = "120hz"; break;
+        case "120hz": Config.options.bar.utilButtons.displayMode = "60hz"; break;
+        default: Config.options.bar.utilButtons.displayMode = "auto"; break;
+        }
+        displayModeDebounce.restart()
+    }
+
+    function applyDisplayMode() {
+        displayModeSocket.pendingMode = Config.options.bar.utilButtons.displayMode
+        if (!displayModeSocket.connected)
+            displayModeSocket.connected = true
+    }
+
+    Component.onCompleted: displayModeDebounce.restart()
+
+    Connections {
+        target: Config.options.bar.utilButtons
+        function onDisplayModeChanged() { displayModeDebounce.restart() }
+    }
+
+    Socket {
+        id: displayModeSocket
+        path: Quickshell.env("XDG_RUNTIME_DIR") + "/end4-display-mode.sock"
+        property string pendingMode: ""
+        property string sentMode: ""
+        onConnectedChanged: {
+            if (connected) {
+                sentMode = pendingMode
+                write(sentMode + "\n")
+                flush()
+            } else if (pendingMode.length > 0) {
+                displayModeDebounce.restart()
+            }
+        }
+        onError: (error) => {
+            if (pendingMode.length > 0) {
+                console.warn("Display mode socket error:", error)
+                displayModeDebounce.restart()
+            }
+        }
+        parser: SplitParser {
+            onRead: (message) => {
+                if (message.trim() !== "ok") {
+                    console.warn("Display mode request failed:", message)
+                    displayModeSocket.pendingMode = ""
+                } else if (displayModeSocket.pendingMode === displayModeSocket.sentMode) {
+                    displayModeSocket.pendingMode = ""
+                }
+            }
+        }
+    }
+
+    Timer {
+        id: displayModeDebounce
+        interval: 1000
+        onTriggered: root.applyDisplayMode()
+    }
+
     Flow {
         id: flow
         anchors.centerIn: parent
