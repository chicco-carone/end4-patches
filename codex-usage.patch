diff --git a/modules/ii/bar/CodexUsage.qml b/modules/ii/bar/CodexUsage.qml
new file mode 100644
index 0000000..1b46145
--- /dev/null
+++ b/modules/ii/bar/CodexUsage.qml
@@ -0,0 +1,153 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import qs.modules.common
+import qs.modules.common.widgets
+
+MouseArea {
+    id: root
+
+    property bool vertical: Config.options.bar.vertical
+    property bool holding: false
+    property int usedPercent: -1
+    property string resetsAt: ""
+    property int weeklyUsedPercent: -1
+    property string weeklyResetsAt: ""
+    property double now: Date.now()
+
+    readonly property bool available: usedPercent >= 0 && resetsAt.length > 0
+    readonly property string timeUntilReset: formatDuration(new Date(resetsAt).getTime() - now)
+    readonly property string weeklyTimeUntilReset: formatDuration(new Date(weeklyResetsAt).getTime() - now)
+
+    implicitWidth: vertical ? Appearance.sizes.verticalBarWidth : content.implicitWidth + 10
+    implicitHeight: vertical ? content.implicitHeight + 8 : Appearance.sizes.barHeight
+    hoverEnabled: true
+    cursorShape: Qt.PointingHandCursor
+
+    function formatDuration(milliseconds) {
+        const totalMinutes = Math.max(0, Math.ceil(milliseconds / 60000))
+        const days = Math.floor(totalMinutes / 1440)
+        const hours = Math.floor(totalMinutes % 1440 / 60)
+        const minutes = totalMinutes % 60
+        if (days > 0) return `${days}d${hours}h`
+        if (hours > 0) return `${hours}h${minutes}m`
+        return `${minutes}m`
+    }
+
+    function parseUsage(text) {
+        try {
+            const accounts = JSON.parse(text)
+            const account = accounts.find(item => item.provider === "codex")
+            const primary = account?.usage?.primary
+            if (!primary || !Number.isFinite(Number(primary.usedPercent)) || !primary.resetsAt)
+                throw new Error("Codex 5-hour usage is unavailable")
+
+            usedPercent = Math.max(0, Math.min(100, Math.round(Number(primary.usedPercent))))
+            resetsAt = primary.resetsAt
+            const secondary = account.usage.secondary
+            weeklyUsedPercent = Number.isFinite(Number(secondary?.usedPercent))
+                ? Math.max(0, Math.min(100, Math.round(Number(secondary.usedPercent)))) : -1
+            weeklyResetsAt = secondary?.resetsAt ?? ""
+        } catch (error) {
+            usedPercent = -1
+            resetsAt = ""
+            weeklyUsedPercent = -1
+            weeklyResetsAt = ""
+        }
+    }
+
+    onPressed: holding = true
+    onReleased: holding = false
+    onCanceled: holding = false
+    onClicked: usageProcess.running = true
+
+    Timer {
+        interval: 60000
+        running: true
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: {
+            root.now = Date.now()
+            if (!usageProcess.running) usageProcess.running = true
+        }
+    }
+
+    Process {
+        id: usageProcess
+        command: ["codexbar", "--json"]
+        stdout: StdioCollector {
+            onStreamFinished: root.parseUsage(text)
+        }
+        onExited: exitCode => {
+            if (exitCode !== 0) root.parseUsage("")
+        }
+    }
+
+    RowLayout {
+        id: content
+        visible: !root.vertical
+        anchors.centerIn: parent
+        spacing: 4
+
+        Image {
+            source: Quickshell.shellPath("assets/icons/codex-color.svg")
+            sourceSize.width: Appearance.font.pixelSize.normal
+            sourceSize.height: Appearance.font.pixelSize.normal
+            Layout.preferredWidth: Appearance.font.pixelSize.normal
+            Layout.preferredHeight: Appearance.font.pixelSize.normal
+        }
+
+        StyledText {
+            font.pixelSize: Appearance.font.pixelSize.smaller
+            font.features: { "tnum": 1 }
+            color: Appearance.colors.colOnLayer1
+            text: root.available ? `${root.usedPercent} · ${root.timeUntilReset}` : "—"
+        }
+    }
+
+    ColumnLayout {
+        visible: root.vertical
+        anchors.centerIn: parent
+        spacing: 1
+
+        Image {
+            Layout.alignment: Qt.AlignHCenter
+            source: Quickshell.shellPath("assets/icons/codex-color.svg")
+            sourceSize.width: Appearance.font.pixelSize.normal
+            sourceSize.height: Appearance.font.pixelSize.normal
+            Layout.preferredWidth: Appearance.font.pixelSize.normal
+            Layout.preferredHeight: Appearance.font.pixelSize.normal
+        }
+
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            font.pixelSize: Appearance.font.pixelSize.smallest
+            font.features: { "tnum": 1 }
+            color: Appearance.colors.colOnLayer1
+            text: root.available ? root.usedPercent : "—"
+        }
+
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            visible: root.available
+            font.pixelSize: Appearance.font.pixelSize.smallest
+            color: Appearance.colors.colOnSurfaceVariant
+            text: root.timeUntilReset
+        }
+    }
+
+    Item {
+        id: holdTarget
+        anchors.fill: parent
+        property bool containsMouse: root.holding
+    }
+
+    CodexUsagePopup {
+        hoverTarget: holdTarget
+        usedPercent: root.usedPercent
+        resetsAt: root.resetsAt
+        weeklyUsedPercent: root.weeklyUsedPercent
+        weeklyResetsAt: root.weeklyResetsAt
+    }
+}
diff --git a/modules/ii/bar/CodexUsagePopup.qml b/modules/ii/bar/CodexUsagePopup.qml
new file mode 100644
index 0000000..f305e61
--- /dev/null
+++ b/modules/ii/bar/CodexUsagePopup.qml
@@ -0,0 +1,101 @@
+import QtQuick
+import QtQuick.Layouts
+import qs.modules.common
+import qs.modules.common.widgets
+
+StyledPopup {
+    id: root
+    property int popupWidth: 240
+    readonly property int contentWidth: popupWidth - 16
+    readonly property int limitRowWidth: contentWidth - 16
+    popupContentWidth: popupWidth
+
+    property int usedPercent: -1
+    property string resetsAt: ""
+    property int weeklyUsedPercent: -1
+    property string weeklyResetsAt: ""
+
+    function formatDuration(milliseconds) {
+        const totalMinutes = Math.max(0, Math.ceil(milliseconds / 60000))
+        const days = Math.floor(totalMinutes / 1440)
+        const hours = Math.floor(totalMinutes % 1440 / 60)
+        const minutes = totalMinutes % 60
+        if (days > 0) return `${days}d ${hours}h`
+        if (hours > 0) return `${hours}h ${minutes}m`
+        return `${minutes}m`
+    }
+
+    component LimitRow: ColumnLayout {
+        required property string iconName
+        required property string title
+        required property string detail
+
+        Layout.minimumWidth: root.limitRowWidth
+        Layout.preferredWidth: root.limitRowWidth
+        Layout.maximumWidth: root.limitRowWidth
+        implicitWidth: root.limitRowWidth
+        spacing: 2
+
+        RowLayout {
+            spacing: 5
+
+            MaterialSymbol {
+                text: parent.parent.iconName
+                iconSize: Appearance.font.pixelSize.normal
+                color: Appearance.colors.colOnSurfaceVariant
+            }
+
+            StyledText {
+                text: parent.parent.title
+                font.pixelSize: Appearance.font.pixelSize.small
+                color: Appearance.colors.colOnSurfaceVariant
+            }
+        }
+
+        StyledText {
+            Layout.leftMargin: Appearance.font.pixelSize.normal + 5
+            text: parent.detail
+            font.pixelSize: Appearance.font.pixelSize.smaller
+            color: Appearance.colors.colOnSurfaceVariant
+            opacity: 0.7
+        }
+    }
+
+    ColumnLayout {
+        width: root.contentWidth
+        implicitWidth: root.contentWidth
+        spacing: 8
+
+        StyledText {
+            text: "Codex usage"
+            font.pixelSize: Appearance.font.pixelSize.normal
+            font.weight: Font.Medium
+            color: Appearance.colors.colOnSurfaceVariant
+        }
+
+        GroupedList {
+            Layout.fillWidth: true
+            bgcolor: Appearance.colors.colSurfaceContainerLow
+            itemVerticalPadding: 14
+
+            LimitRow {
+                Layout.fillWidth: true
+                iconName: "timer"
+                title: "5-hour limit"
+                detail: root.usedPercent >= 0
+                    ? `${root.usedPercent} used · ${root.formatDuration(new Date(root.resetsAt).getTime() - Date.now())} left`
+                    : "Unavailable"
+            }
+
+            LimitRow {
+                Layout.fillWidth: true
+                visible: root.weeklyResetsAt.length > 0
+                iconName: "calendar_month"
+                title: "Weekly limit"
+                detail: root.weeklyUsedPercent >= 0
+                    ? `${root.weeklyUsedPercent} used · ${root.formatDuration(new Date(root.weeklyResetsAt).getTime() - Date.now())} left`
+                    : root.formatDuration(new Date(root.weeklyResetsAt).getTime() - Date.now()) + " left"
+            }
+        }
+    }
+}
